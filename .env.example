# Gateway client headers (optional, for private wikis)
# Sent as X-OAuth-Client-Id and X-OAuth-Client-Secret to whichever wiki is queried.
# REFRACT_OAUTH_CLIENT_ID=
# REFRACT_OAUTH_CLIENT_SECRET=

# Inference provider (optional, for refract classify and the MCP classify tool)
# REFRACT_INFERENCE_API_KEY=
# REFRACT_INFERENCE_ENDPOINT=https://api.openai.com/v1/chat/completions
# REFRACT_INFERENCE_MODEL=gpt-4o-mini

# Notifications (optional, for refract cron)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SMTP_TO=alerts@example.com
# SMTP_SENDMAIL=/usr/sbin/sendmail

{
	"name": "refract-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Standalone visualization UI for Refract — load JSONL, render timelines, diffs, citations",
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/refract-org/refract.git",
		"directory": "apps/ui"
	},
	"homepage": "https://github.com/refract-org/refract/tree/main/apps/ui#readme",
	"bugs": {
		"url": "https://github.com/refract-org/refract/issues"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write .",
		"assets:check": "bun run scripts/check-assets.ts",
		"assets:generate": "bun run scripts/generate-scenes.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@refract-org/evidence-graph": "workspace:*",
		"happy-dom": "^20.14.5",
		"typescript": "^5.7.0",
		"vite": "^6.0.0",
		"vitest": "^4.1.10"
	}
}
